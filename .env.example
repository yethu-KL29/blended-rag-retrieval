# Set these in the process environment. This application does not auto-load .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
MONGODB_DATABASE=compliance_rag
MONGODB_COLLECTION=aintropy_blended_nist_gemini768_v1
ATLAS_TEXT_INDEX=aintropy_nist_gemini_text_v1
ATLAS_VECTOR_INDEX=aintropy_nist_gemini_vector_v1
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Alternative: explicit Vertex/ADC, with no API key required.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Set privately for a service-account JSON, or use ADC already configured in your environment.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\private\\service-account.json"
# The fitted model is loaded from --store; it must match the Atlas collection.
# Set RUN_ATLAS_TESTS=1 only for a dedicated disposable integration collection.
