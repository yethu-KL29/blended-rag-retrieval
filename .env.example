# Set these in the process environment. This application does not auto-load .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
MONGODB_DATABASE=compliance_rag
MONGODB_COLLECTION=chunks
ATLAS_TEXT_INDEX=compliance_text
ATLAS_VECTOR_INDEX=compliance_vector
# The fitted model is loaded from --store; it must match the Atlas collection.
# Set RUN_ATLAS_TESTS=1 only for a dedicated disposable integration collection.
